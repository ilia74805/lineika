{
  "manifest_version": 3,
  "name": "Линейка",
  "short_name": "Линейка",
  "version": "1.0.0",
  "description": "Боковая панель для школьных задач: локальная мини-модель, калькулятор, конспекты 1–11 и курсор, который вписывает ответ.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть Линейку"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
